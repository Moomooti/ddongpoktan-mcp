{
  "name": "ddongpoktan-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ddongpoktan(똥폭탄) - a chaotic KakaoTalk group-chat poop-throwing game. Remote MCP server for Kakao PlayMCP (Agentic Player 10).",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "bash scripts/smoke.sh",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "inspector": "npx @modelcontextprotocol/inspector --cli http://localhost:3000/mcp --transport http --method tools/list"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^11.3.0",
    "express": "^4.22.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
